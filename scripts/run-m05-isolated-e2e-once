#!/usr/bin/bash
# M05 disposable bridge runtime을 정확히 한 번만 실행하는 root launcher.
set -euo pipefail

# 기본값은 **보존**이다. 27개 terminal 중 4개 candidate를 태운 원인(Compose
# `ports: !reset` 한 줄)은 stderr 한 번이면 즉시 보였을 값이었고, 발견 수단도 root
# forensic의 rendered config 열람이었다 — 관측 결핍이 후보 예산을 소비했다
# (ktm-m03 docs/reports/map-stall-root-cause-2026-08-31.md §3 I-2, 적대 검증 CONFIRMED).
# 보존 대상은 이미 bounded-drain한 stderr뿐이고 root 0600 leaf를 벗어나지 않는다 —
# 공개 registry·tracked 문서·대화 기록으로 옮기지 않는 것이 규칙이다.
forensic_capture=1
if [[ "$#" == 3 && "$1" == "--forensic-capture" ]]; then
  # 종전 opt-in 인자는 호환으로 유지한다(이미 기본값).
  forensic_capture=1
  shift
elif [[ "$#" == 3 && "$1" == "--no-forensic-capture" ]]; then
  forensic_capture=0
  shift
fi
if [[ "$#" != 2 ]]; then
  echo "usage: run-m05-isolated-e2e-once [--forensic-capture|--no-forensic-capture] EXPECTED_MANAGER_SOURCE_REVISION ROOT_OWNED_OUTPUT_DIRECTORY" >&2
  exit 2
fi
if [[ "$(id -u)" != 0 ]]; then
  echo "M05 isolated launcher must run as root" >&2
  exit 2
fi
if (( forensic_capture )); then
  # 캡처 leaf는 stderr(.stderr)뿐 아니라 compose config stdout(.stdout)도 포함한다.
  # 전부 root 0600이며, driver가 _RAW_ENV_NAMES 비밀값을 내용-scrub한 뒤에만 남는다
  # (R1-S9). raw 그대로의 유출 경로가 아니다 — 하지만 tracked 문서/대화로 옮기지 말 것.
  export KTDM_M05_FORENSIC_CAPTURE=1
  launcher_arguments=(--forensic-capture "$@")
else
  # opt-out 시에는 호출 shell의 우연한 환경값이 raw retention을 켜지 못하게 한다.
  unset KTDM_M05_FORENSIC_CAPTURE
  launcher_arguments=("$@")
fi
expected_revision="$1"
output_dir="$2"
if [[ ! "$expected_revision" =~ ^[0-9a-f]{40}$ || "$output_dir" != /* || -e "$output_dir" ]]; then
  echo "M05 isolated launcher arguments are invalid" >&2
  exit 2
fi

# rebuild one-shot과 동일한 host-global lock을 process lifetime 전체에 보존한다.
if [[ -z "${KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD:-}" ]]; then
  exec /usr/bin/python3 -I -S - "${BASH_SOURCE[0]}" "${launcher_arguments[@]}" <<'PY'
import fcntl
import os
from pathlib import Path
import stat
import sys

script = Path(sys.argv[1]).resolve(strict=True)
arguments = sys.argv[2:]
directory = Path("/run/lock/kor-travel-docker-manager")
path = directory / "global-mutation.lock"
directory.mkdir(mode=0o700, parents=True, exist_ok=True)
metadata = directory.lstat()
if (stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != 0 or stat.S_IMODE(metadata.st_mode) != 0o700):
    raise SystemExit("M05 global mutation lock directory is unsafe")
if not hasattr(os, "O_NOFOLLOW"):
    raise SystemExit("M05 global mutation lock requires O_NOFOLLOW")
fd = os.open(path, os.O_CREAT | os.O_RDWR | os.O_CLOEXEC | os.O_NOFOLLOW, 0o600)
opened = os.fstat(fd)
if (not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1
        or opened.st_uid != 0 or stat.S_IMODE(opened.st_mode) != 0o600):
    os.close(fd)
    raise SystemExit("M05 global mutation lock is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    os.close(fd)
    raise SystemExit("another manager mutation is already active") from exc
os.set_inheritable(fd, True)
env = dict(os.environ)
env["KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD"] = str(fd)
os.execve("/usr/bin/bash", ["/usr/bin/bash", str(script), *arguments], env)
PY
fi

lock_fd="${KTDM_PINNED_REBUILD_GLOBAL_LOCK_FD}"
if [[ ! "$lock_fd" =~ ^[0-9]+$ ]]; then
  echo "M05 global mutation lock descriptor is invalid" >&2
  exit 2
fi
/usr/bin/python3 -I -S - "$lock_fd" <<'PY'
import fcntl
import os
from pathlib import Path
import stat
import sys

fd = int(sys.argv[1])
path = Path("/run/lock/kor-travel-docker-manager/global-mutation.lock")
opened = os.fstat(fd)
named = path.lstat()
if ((opened.st_dev, opened.st_ino) != (named.st_dev, named.st_ino)
        or not stat.S_ISREG(opened.st_mode) or opened.st_nlink != 1
        or opened.st_uid != 0 or stat.S_IMODE(opened.st_mode) != 0o600):
    raise SystemExit("M05 global mutation lock descriptor is unsafe")
try:
    fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError as exc:
    raise SystemExit("M05 global mutation lock is not held") from exc
PY

parent="$(dirname "$output_dir")"
if [[ ! -d "$parent" || -L "$parent" || "$(stat -c '%u' "$parent")" != 0 ]]; then
  echo "M05 output parent is unsafe" >&2
  exit 2
fi
if (( 8#$(stat -c '%a' "$parent") & 022 )); then
  echo "M05 output parent is writable by another principal" >&2
  exit 2
fi

# source pinset과 Manager release를 별도 v6 execution으로 결박한다. output leaf 생성보다
# 먼저 root registry와 public copy를 함께 검증한다. 과거 v5 terminal은 audit이며, 현재
# exact execution terminal만 재실행을 막는다.
ktdctl="/opt/kor-travel-docker-manager/backend/.venv/bin/ktdctl"
snapshot_runtime_pin() {
  timeout 30 "$ktdctl" pin show --json | /usr/bin/python3 -I -S -c '
from __future__ import annotations

import json
import sys

value = json.load(sys.stdin)
if not isinstance(value, dict):
    raise SystemExit(1)
pinset = value.get("pinset_sha256")
sources = value.get("sources")
if not isinstance(sources, list) or len(sources) != 2:
    raise SystemExit(1)
revisions = {entry.get("role"): entry.get("revision") for entry in sources if isinstance(entry, dict)}
map_revision = revisions.get("map")
pinvi_revision = revisions.get("pinvi")
for expected_length, item in ((64, pinset), (40, map_revision), (40, pinvi_revision)):
    if not isinstance(item, str) or len(item) != expected_length or any(
        char not in "0123456789abcdef" for char in item
    ):
        raise SystemExit(1)
print(pinset, map_revision, pinvi_revision)
'
}
if ! "$ktdctl" pin verify --json >/dev/null 2>&1; then
  echo "M05 runtime execution registry is not runnable" >&2
  exit 1
fi
initial_snapshot="$(snapshot_runtime_pin)" || {
  echo "M05 runtime pin snapshot is invalid" >&2
  exit 1
}
# 외부 rotate-pair는 이 launcher의 lifetime lock에 막힌다 — ktdctl의
# non-inherited 경로가 flock(LOCK_EX|LOCK_NB)로 거절한다(cli.py).
# 그래도 두 번째 검증 snapshot을 두는 이유는 회전 경합이 아니라, 이 창에서
# 값이 흔들리면 그것 자체가 관측 이상이라는 것을 시작 시점에 못 박기 위함이다. A second verified
# snapshot establishes the exact candidate owned by this one-shot; acceptance
# below requires it to remain unchanged through driver completion.
snapshot_runtime_execution() {
  timeout 30 "$ktdctl" pin show-execution --json | /usr/bin/python3 -I -S -c '
from __future__ import annotations

import json
import sys

value = json.load(sys.stdin)
current = value.get("current") if isinstance(value, dict) else None
if not isinstance(current, dict):
    raise SystemExit(1)
execution = current.get("execution_identity_sha256")
pinset = current.get("source_pinset_sha256")
revision = current.get("manager_source_revision")
for expected_length, item in ((64, execution), (64, pinset), (40, revision)):
    if not isinstance(item, str) or len(item) != expected_length or any(
        char not in "0123456789abcdef" for char in item
    ):
        raise SystemExit(1)
print(execution, pinset, revision)
'
}
initial_execution_snapshot="$(snapshot_runtime_execution)" || {
  echo "M05 runtime execution snapshot is invalid" >&2
  exit 1
}
if ! "$ktdctl" pin verify --json >/dev/null 2>&1; then
  echo "M05 runtime execution registry is not runnable" >&2
  exit 1
fi
stable_snapshot="$(snapshot_runtime_pin)" || {
  echo "M05 runtime pin snapshot is invalid" >&2
  exit 1
}
stable_execution_snapshot="$(snapshot_runtime_execution)" || {
  echo "M05 runtime execution snapshot is invalid" >&2
  exit 1
}
if [[ "$initial_snapshot" != "$stable_snapshot" || "$initial_execution_snapshot" != "$stable_execution_snapshot" ]]; then
  echo "M05 runtime pin registry changed before launch" >&2
  exit 1
fi
read -r initial_pinset initial_map_revision initial_pinvi_revision <<<"$initial_snapshot"
read -r initial_execution initial_execution_pinset initial_execution_revision <<<"$initial_execution_snapshot"
if [[ "$initial_execution_pinset" != "$initial_pinset" || "$initial_execution_revision" != "$expected_revision" ]]; then
  echo "M05 runtime execution snapshot differs from launch candidate" >&2
  exit 1
fi
# Map/PinVi integration provenance는 generic pin registry가 아니라 M05 adapter가 소유한다.
# 이를 one-shot ledger/output leaf 전에 검사해 잘못 회전한 source pair가 execution terminal을
# 소비하지 않게 한다. stderr 원문은 기존 launcher 경계와 같이 보관하지 않는다.
# driver가 stdout에 내는 **닫힌 어휘** 거부 사유는 받는다 — 자유 문자열이 아니라
# driver가 allowlist로 거른 값이다. 종전에는 그것마저 버려서 이 거부가 어디서
# 났는지 알 방법이 없었다: 2026-09-02에 71분짜리 rebuild를 태운 뒤 이 한 줄에
# 막히고도 이유를 몰라 traceback으로 역추적해야 했다.
# `set -e` 아래서는 실패한 명령 치환이 대입 자리에서 곧바로 스크립트를 죽여
# 메시지를 잃는다. 포착을 위해 그 구간만 연다.
set +e
preflight_detail="$(
  /opt/kor-travel-docker-manager/backend/.venv/bin/python -I \
    /opt/kor-travel-docker-manager/scripts/m05_isolated_e2e.py \
    --preflight "$expected_revision" 2>/dev/null
)"
preflight_status="$?"
set -e
if [[ "${preflight_status}" != 0 ]]; then
  echo "M05 isolated source pair preflight is not runnable: ${preflight_detail}" >&2
  exit 1
fi
# driver가 남긴 기록이 scoped(phase-scoped, 보정 후 재실행 가능)든 무조건이든,
# 이 launch snapshot(execution/pinset/revision)에 결박돼 있으면 blocked receipt의
# durable 근거로 인정한다(적대 리뷰 R1-S1: 무조건 기록만 인정하면 launcher가
# 모든 인프라 실패를 아래 fallback에서 무조건 차단으로 승격해 I-1을 무효화한다).
has_any_terminal_execution_block() {
  timeout 30 "$ktdctl" pin show-execution --json | /usr/bin/python3 -I -S -c '
from __future__ import annotations

import json
import sys

execution, pinset, revision = sys.argv[1:]
value = json.load(sys.stdin)
entries = value.get("blocked_executions") if isinstance(value, dict) else None
if not isinstance(entries, list):
    raise SystemExit(1)
if not any(
    isinstance(entry, dict)
    and entry.get("execution_identity_sha256") == execution
    and entry.get("source_pinset_sha256") == pinset
    and entry.get("manager_source_revision") == revision
    for entry in entries
):
    # 3 = registry를 정상으로 읽었고 일치 항목이 없다. 1(판독 불가)과 구분해야
    # ktdctl 딸꾹질이 "기록 없음"으로 접혀 scoped 차단을 무조건 소각으로
    # 승격시키지 않는다(적대 리뷰).
    raise SystemExit(3)
' "$initial_execution" "$initial_pinset" "$expected_revision"
}

has_unconditional_terminal_execution_block() {
  timeout 30 "$ktdctl" pin show-execution --json | /usr/bin/python3 -I -S -c '
from __future__ import annotations

import json
import sys

execution, pinset, revision = sys.argv[1:]
value = json.load(sys.stdin)
entries = value.get("blocked_executions") if isinstance(value, dict) else None
if not isinstance(entries, list):
    raise SystemExit(1)
if not any(
    isinstance(entry, dict)
    and entry.get("execution_identity_sha256") == execution
    and entry.get("source_pinset_sha256") == pinset
    and entry.get("manager_source_revision") == revision
    and entry.get("phase") is None
    for entry in entries
):
    # 3 = registry를 정상으로 읽었고 일치 항목이 없다. 1(판독 불가)과 구분해야
    # ktdctl 딸꾹질이 "기록 없음"으로 접혀 scoped 차단을 무조건 소각으로
    # 승격시키지 않는다(적대 리뷰).
    raise SystemExit(3)
' "$initial_execution" "$initial_pinset" "$expected_revision"
}
install -d -o root -g root -m 0700 "$output_dir"

set +e
/opt/kor-travel-docker-manager/backend/.venv/bin/python -I \
  /opt/kor-travel-docker-manager/scripts/m05_isolated_e2e.py \
  "$expected_revision" "$output_dir" >/dev/null 2>&1
driver_status="$?"
set -e

# Driver가 terminal block까지 남기기 전에 interpreter/결과 쓰기 경계에서 끝나도, 원문
# stderr를 보관하거나 재시도 근거로 쓰지 않는다. 고정 schema·snapshot·종료값이 모두
# 일치한 `result.json`만 수용한다. launcher fallback가 있으면 그 파일이 언제나 권위다.
result_path="$output_dir/result.json"
launcher_result_path="$output_dir/launcher-result.json"
# 관측 실패와 registry 회전을 같은 값으로 접으면 **관측자의 딸꾹질이 피관측자를
# 태운다**. driver 실행 **전**에는 같은 함수의 exit status를 살려 쓰는데(위 참조)
# 후에는 `|| true`가 그걸 지워, fork 실패·ENOMEM·venv 경합 같은 일시 실패에서
# receipt_validation_status가 초기값 1(= "receipt가 아예 없다")에 머물고 곧장
# `pin block-execution`으로 간다 — receipt를 **읽어보지도 않고** 소각한다.
# 회전은 안 났으므로 CLI의 current_matches가 참이라 소각이 실제로 성공한다.
# 한 번 재시도하고, 그래도 관측이 안 되면 그 사실을 회전과 구분해 남긴다.
snapshot_pair() {
  # 전역 두 개를 직접 채운다 — 중간 표현을 두면 값에 개행이 없다는 보장에
  # 암묵적으로 의존하게 되고, 빈 값이 조용히 행 소실로 나타난다(적대 리뷰).
  # stderr를 죽이지 않는다 — driver 전 관측(initial_snapshot)과 대칭이고,
  # 이 파일 헤더가 '관측 결핍이 후보 예산을 소비했다'를 설계 원칙으로 선언한다.
  # 죽이면 재현 불가능한 1~2시간짜리 실행의 실패 원인이 정확히 지워진다.
  post_snapshot="$(snapshot_runtime_pin)" || return 1
  post_execution_snapshot="$(snapshot_runtime_execution)" || return 1
}
post_snapshot=""
post_execution_snapshot=""
post_observed=0
for _attempt in 1 2; do
  if snapshot_pair; then
    post_observed=1
    break
  fi
  # 겨냥한 실패(fork 실패·ENOMEM·venv 경합)는 수십~수백 ms 창이다. 간격 없이
  # 두 번 부르면 같은 창에서 함께 실패해 재시도가 사실상 1회다(적대 리뷰).
  sleep 1
done
receipt_validation_status=1
snapshot_changed=0
if [[ "$post_observed" == 1 ]] &&
   { [[ "$post_snapshot" != "$initial_snapshot" ]] ||
     [[ "$post_execution_snapshot" != "$initial_execution_snapshot" ]]; }; then
  snapshot_changed=1
  # launcher는 자기 수명 내내 host-global mutation lock을 쥐고 있고, ktdctl의
  # non-inherited 경로는 flock(LOCK_EX|LOCK_NB)로 rotate-pair/rollback/block을
  # 거절한다. 즉 이 창에서 **회전은 물리적으로 불가능하다** — 값 불일치는 회전이
  # 아니라 또 다른 관측 이상이다. 그러니 이것도 receipt를 안 읽을 이유가 못 된다.
  echo "M05 runtime snapshot differs after the driver" >&2
fi
if [[ "$post_observed" != 1 ]]; then
  # 관측 불가는 회전의 증거가 **아니다**. 그렇다고 소각을 건너뛰기만 하면
  # 더 나쁘다 — driver가 본문 진입 뒤 하드 크래시하면 원장에 block이 없고
  # `pin verify`가 '실행 가능'을 보고하며 원장 claim은 재시도를 허용하므로,
  # 운영자가 문서대로 재실행하면 **본문이 두 번 돈다**(적대 리뷰 BLOCKER).
  #
  # 그래서 관측 실패는 snapshot 등가 **게이트만 무효화**하고, receipt는 그대로
  # 읽는다. receipt는 바로 옆에 있는 root 0600 파일이고 ktdctl 없이 읽힌다.
  # Tier 1이 revision·pinset·execution identity·transaction으로 이미 이 launch에
  # 결박하므로 snapshot 등가 없이도 '이 실행의 receipt인가'는 증명된다.
  # 결박에 실패하면(exit 1) 종전대로 소각으로 떨어진다.
  echo "M05 runtime snapshot is unobservable after the driver" >&2
fi
if [[ ! -e "$launcher_result_path" ]]; then
  set +e
  /usr/bin/python3 -I -S - "$result_path" "$expected_revision" "$initial_pinset" "$initial_execution" "$driver_status" <<'PY'
from __future__ import annotations

import json
import pathlib
import re
import stat
import sys

path = pathlib.Path(sys.argv[1])
expected_revision = sys.argv[2]
expected_pinset = sys.argv[3]
expected_execution = sys.argv[4]
driver_status = int(sys.argv[5])
PHASES = frozenset(
    {
        "arguments_invalid", "runtime_command_output_too_large",
        "admission", "source_materialization", "ledger_claim", "runtime_setup",
        "execution_identity_consumed",
        "map_runtime", "map_postgres_start_failed", "map_fresh_init_failed",
        "map_application_start_failed", "map_health_status_failed",
        "map_health_transport_failed", "map_subscription",
        "map_subscription_http_failed", "pinvi_runtime", "m04_m05_e2e",
        "driver_contract_failed", "runtime_cleanup_failed", "runtime_execution_block_failed",
        "m04_fixture_http_failed", "m04_fixture_invalid",
        "m04_map_approval_http_failed", "m04_map_approval_invalid",
        "m04_map_feature_ref_resolve_failed",
        "m05_case_decision_http_failed", "m05_case_invalid",
        "m05_case_lookup_http_failed", "m05_fixture_invalid",
        "m05_pinvi_receipt_blocked", "m05_pinvi_receipt_http_failed",
        "m05_pinvi_receipt_invalid", "m05_pinvi_receipt_not_ready",
        "m05_pinvi_seed_http_failed", "m05_pinvi_seed_invalid",
        "m05_pinvi_impact_missing", "network_inspect_invalid",
        "network_subnet_unavailable", "pair_contract_invalid", "pinvi_auth_invalid",
        "pinvi_login_http_failed", "pinvi_manager_admission_contract_invalid",
        "ports_unavailable", "result_write_failed", "runtime_command_failed",
        "runtime_container_identity_invalid", "runtime_directory_invalid",
        "runtime_http_contract_failed", "runtime_http_failed", "runtime_http_url_invalid",
        "runtime_image_identity_invalid", "runtime_inspect_invalid",
        "runtime_loopback_publish_invalid",
        "runtime_loopback_publish_config_invalid",
        "runtime_pin_registry_changed", "runtime_pin_registry_invalid",
        "runtime_execution_registry_changed", "runtime_execution_registry_invalid",
        "runtime_setup_admission", "runtime_setup_admission_build",
        "runtime_setup_admission_write", "runtime_setup_credentials",
        "runtime_setup_map_config", "runtime_setup_network",
        "runtime_setup_pinvi_config", "runtime_setup_playwright_runner_image", "runtime_setup_ports",
        "runtime_setup_workspace",
        "secret_cleanup_identity_invalid", "terminal_execution_blocked",
        "trusted_release_invalid", "trusted_release_revision_mismatch", "completed",
    }
)
PREFLIGHT_REJECTED_PHASES = frozenset(
    # driver의 _PRE_CLAIM_PHASES를 그대로 미러한다 — 부분집합만 알면
    # 재시도 가능한 pre-claim 실패가 무조건 소각으로 승격되고, 반대로
    # 초과집합이면 claim 소비를 증명하는 phase가 통과한다.
    {
        "admission",
        "arguments_invalid",
        "driver_contract_failed",
        "execution_identity_consumed",
        "network_inspect_invalid",
        "network_subnet_unavailable",
        "pair_contract_invalid",
        "pinvi_manager_admission_contract_invalid",
        "ports_unavailable",
        "result_write_failed",
        "runtime_command_failed",
        "runtime_command_output_too_large",
        "runtime_directory_invalid",
        "runtime_execution_registry_changed",
        "runtime_execution_registry_invalid",
        "runtime_loopback_publish_config_invalid",
        "runtime_loopback_publish_invalid",
        "runtime_pin_registry_changed",
        "runtime_pin_registry_invalid",
        "runtime_setup_admission",
        "runtime_setup_admission_build",
        "runtime_setup_admission_write",
        "runtime_setup_credentials",
        "runtime_setup_map_config",
        "runtime_setup_network",
        "runtime_setup_playwright_runner_image",
        "runtime_setup_ports",
        "runtime_setup_workspace",
        "source_materialization",
        "terminal_execution_blocked",
        "trusted_release_invalid",
        "trusted_release_revision_mismatch",
    }
)
# launcher는 범용 one-shot runner다 — tenant의 migration 어휘를 알 필요가 없고,
# 알면 그 목록이 tenant 쪽 목록과 갈라지는 순간 정상 receipt가 소각된다(적대 리뷰).
# 실제 안전 속성은 "raw driver 출력이 아니라 불투명한 소문자 토큰"이라는 **모양**뿐이다.
# 생성되는 비밀은 모두 token_urlsafe/token_hex라 이 모양에 걸리지 않는다.
DIAGNOSTIC_TOKEN = re.compile(r"[a-z][a-z0-9_]{0,63}\Z")
HEX = frozenset("0123456789abcdef")
try:
    metadata = path.lstat()
    if (
        path.is_symlink()
        or not stat.S_ISREG(metadata.st_mode)
        or metadata.st_uid != 0
        or stat.S_IMODE(metadata.st_mode) != 0o600
        or metadata.st_nlink != 1
    ):
        raise ValueError
    with path.open(encoding="utf-8") as handle:
        value = json.load(handle)
    if not isinstance(value, dict):
        raise ValueError
    # ---- Tier 1: 권위(authority) ----------------------------------------
    # 이 receipt를 **이 launch에 결박**하는 사실들. 하나라도 어긋나면 receipt를
    # 이 실행의 것으로 볼 수 없으므로 fail-close(소각)가 옳다.
    if (
        value.get("harness") != "m05-isolated-bridge-v1"
        or value.get("manager_source_revision") != expected_revision
        or value.get("pinset_sha256") != expected_pinset
        or value.get("execution_identity_sha256") != expected_execution
        or value.get("status") not in {"passed", "blocked", "preflight_rejected"}
        or not isinstance(value.get("transaction_id"), str)
        or len(value["transaction_id"]) != 32
        or any(char not in HEX for char in value["transaction_id"])
        or (value["status"] == "passed") != (driver_status == 0)
    ):
        raise ValueError
    if value["status"] == "passed":
        # passed는 소각이 아니라 **성공 주장**이라 계속 엄격하게 본다.
        if (
            value.get("phase") != "completed"
            or value.get("driver_phase") != "completed"
            or value.get("cleanup_failed") is not False
        ):
            raise ValueError
        for key in (
            "m04_attestation_sha256", "m05_attestation_sha256", "runtime_provenance_sha256"
        ):
            digest = value.get(key)
            if not isinstance(digest, str) or len(digest) != 64 or any(char not in HEX for char in digest):
                raise ValueError
    if value["status"] == "preflight_rejected" and driver_status == 0:
        raise ValueError

    # ---- Tier 2: 진단(diagnostics) --------------------------------------
    # phase 어휘·key 집합·선택 필드. 여기서 어긋난다는 건 driver와 launcher의
    # 기술이 갈라졌다는 뜻이지, **실행권이 소비됐다는 뜻이 아니다.** 종전에는
    # 이 실패가 "receipt가 아예 없다"와 같은 값(exit 1)으로 접혀 무조건 소각으로
    # 갔다 — 관측자의 딸꾹질이 피관측자를 태우는 구조였다(적대 리뷰 Part A).
    # 이제 Tier 1이 깨끗하면 receipt가 주장한 status로 종료하되, 저하됐음을
    # 별도 종료값으로 알린다.
    expected_keys = {
        "harness", "manager_source_revision", "phase", "driver_phase",
        "cleanup_failed", "disposable_run_worktree_retained",
        "pinset_sha256", "execution_identity_sha256", "status", "transaction_id",
    }
    if value["status"] == "passed":
        expected_keys |= {
            "m04_attestation_sha256", "m05_attestation_sha256",
            "runtime_provenance_sha256",
        }
    if "map_fresh_init_reason" in value:
        expected_keys.add("map_fresh_init_reason")
    reason = value.get("map_fresh_init_reason")
    degraded = (
        set(value) != expected_keys
        or value.get("phase") not in PHASES
        or value.get("driver_phase") not in PHASES
        or not isinstance(value.get("cleanup_failed"), bool)
        # 일회용 체크아웃이 남았다는 사실은 실행을 태우지 않는다(핀 상태를 오염시키지
        # 못하는 output leaf 안의 사본이다). 그래도 receipt에는 있어야 한다.
        or not isinstance(value.get("disposable_run_worktree_retained"), bool)
        or (reason is not None and (
            not isinstance(reason, str) or DIAGNOSTIC_TOKEN.fullmatch(reason) is None
        ))
        or (
            value["status"] == "preflight_rejected"
            and (
                value.get("phase") not in PREFLIGHT_REJECTED_PHASES
                or value.get("driver_phase") != value.get("phase")
                or value.get("cleanup_failed") is not False
            )
        )
    )
except (OSError, UnicodeDecodeError, ValueError, json.JSONDecodeError):
    raise SystemExit(1)
if degraded:
    # passed 주장만은 저하된 채로 수용하지 않는다 — 성공은 완전한 receipt로만
    # 인정한다. 그 밖에는 Tier 1이 증명한 status를 따른다.
    raise SystemExit(1 if value["status"] == "passed" else 5)
raise SystemExit(
    0
    if value["status"] == "passed"
    else 4
    if value["status"] == "preflight_rejected"
    else 3
)
PY
  receipt_validation_status="$?"
  set -e
fi
# 소각은 **실행권이 소비됐다는 양성 증거**가 있을 때만 정당하다. 아래 분기는
# 그 원칙 하나로 정리돼 있다 — 관측자(launcher)의 불확실성은 절대 피관측자
# (candidate)를 태우지 않는다(적대 리뷰 전수 감사).
case "$receipt_validation_status" in
  0)
    exit "$driver_status"
    ;;
  4)
    # driver가 ledger claim 전에 거부했다 — 실행권 미소비가 증명됐다.
    exit "$driver_status"
    ;;
  5)
    # Tier 1(권위)은 전부 일치하고 Tier 2(진단)만 어긋났다. receipt가 이
    # launch에 결박됐음이 증명됐으므로 "정체불명 crash"가 아니다.
    echo "M05 isolated receipt is degraded but bound to this launch" >&2
    exit "$driver_status"
    ;;
  3)
    # blocked receipt는 claim을 증명한다. 다만 driver가 남긴 차단이 scoped면
    # 그대로 두어야 한다 — 여기서 무조건 차단을 얹으면 재시도 가능한 인프라
    # 실패가 소각으로 승격된다(R1-S1).
    set +e
    has_any_terminal_execution_block
    block_probe_status="$?"
    set -e
    if [[ "$block_probe_status" == 0 ]]; then
      exit "$driver_status"
    fi
    if [[ "$block_probe_status" != 3 ]]; then
      # registry를 읽지 못했다. 이건 "기록이 없다"가 아니다 — 같은 ktdctl
      # 딸꾹질이고, 그걸 근거로 승격하면 scoped 차단이 소각이 된다.
      echo "M05 terminal execution block is unreadable" >&2
      exit 1
    fi
    ;;
  *)
    # receipt를 읽지 못했다(부재 / 결박 실패 / 검증기 도구 자체가 죽음 —
    # 126·127·137·미포착 예외가 전부 여기로 온다). 소비 여부는 driver가 claim
    # 직후 남기는 root 0600 마커로 판정한다. 마커 없이 태우면 claim 전에 죽은
    # 실행을 헛소각하고, 마커가 있는데 안 태우면 본문이 두 번 돈다.
    if [[ ! -e "$output_dir/claimed" ]]; then
      echo "M05 driver did not claim the execution" >&2
      exit 1
    fi
    ;;
esac

# generic execution block은 driver가 terminal block을 먼저 남긴 경우에도
# idempotent다. trusted 현재 binding이 snapshot에서 달라지면 CLI가 fail-close한다.
set +e
"$ktdctl" pin block-execution \
  --reason 'M05 isolated launcher safe result unavailable' --confirm >/dev/null 2>&1
block_write_status="$?"
set -e
if [[ "$block_write_status" != 0 ]]; then
  # 이 파일에서 결과가 가장 무거운 명령이 유일하게 상태를 포착하지 않고 있었다.
  # set -e에 먹히면 아래 durability 진단에도, fixed fallback 봉투에도 도달하지
  # 못한 채 조용히 죽는다 — 문서가 약속한 fail-close가 일어나지 않는다(적대 리뷰).
  echo "M05 terminal execution block command failed" >&2
fi

# block write가 phase-scoped 기록으로 끝나거나 다른 pair를 block한 경우에는 이
# candidate를 재실행할 수 있으므로 fail-close한다. stdout에는 registry 원문을 남기지 않는다.
if ! has_unconditional_terminal_execution_block; then
  echo "M05 runtime execution terminal block is not durable" >&2
  exit 1
fi

# launcher-result.json is always the fallback authority. It is created only
# once, never overwrites a driver result, and carries no raw driver output.
fallback_path="$launcher_result_path"
/usr/bin/python3 -I -S - "$fallback_path" "$expected_revision" "$initial_pinset" "$initial_execution" <<'PY'
from __future__ import annotations

import json
import os
import pathlib
import stat
import sys

path = pathlib.Path(sys.argv[1])
revision = sys.argv[2]
pinset = sys.argv[3]
execution = sys.argv[4]
parent = path.parent.lstat()
if (
    path.is_absolute() is False
    or path.is_symlink()
    or not stat.S_ISDIR(parent.st_mode)
    or parent.st_uid != 0
    or stat.S_IMODE(parent.st_mode) != 0o700
):
    raise SystemExit(1)
payload = (
    json.dumps(
        {
            # 이 봉투는 receipt가 아니라 **launcher의 표식**이다. 종전에는
            # receipt와 같은 harness 태그를 달고, tenant의 phase 네임스페이스에
            # 없는 토큰을 phase/driver_phase로 발명했다 — 같은 harness 이름으로
            # 두 파일이 서로 다른 스키마를
            # 주장하고, launcher가 관측한 적 없는 phase를 주장하는 셈이었다.
            # 범용 runner가 tenant 어휘를 발명하는 것은 방금 제거한 결함과 같은
            # 계열이므로(DIAGNOSTIC_TOKEN 주석 참조) phase 키를 아예 뺀다.
            "cleanup_failed": True,
            "harness": "m05-isolated-launcher-fallback-v1",
            "launcher_outcome": "safe_result_unavailable",
            "manager_source_revision": revision,
            "pinset_sha256": pinset,
            "execution_identity_sha256": execution,
            "status": "blocked",
        },
        ensure_ascii=True,
        separators=(",", ":"),
        sort_keys=True,
    )
    + "\n"
).encode("ascii")
flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
fd = os.open(path, flags, 0o600)
try:
    view = memoryview(payload)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise SystemExit(1)
        view = view[written:]
    os.fsync(fd)
finally:
    os.close(fd)
metadata = path.lstat()
if (
    not stat.S_ISREG(metadata.st_mode)
    or metadata.st_uid != 0
    or stat.S_IMODE(metadata.st_mode) != 0o600
    or metadata.st_nlink != 1
):
    raise SystemExit(1)
directory = os.open(path.parent, os.O_RDONLY | os.O_CLOEXEC)
try:
    os.fsync(directory)
finally:
    os.close(directory)
PY

exit 1
